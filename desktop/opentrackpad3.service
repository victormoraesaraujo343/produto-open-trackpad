# Serviço do OpenTrackpad (fase 3) para o usuário. Instalado por desktop/instalar.sh.
# Nome diferente do da v0.2 (opentrackpad.service) para os dois poderem conviver.
[Unit]
Description=OpenTrackpad (celular como trackpad e periférico)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/otpd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
